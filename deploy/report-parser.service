[Unit]
Description=Report Parser web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reportparser
Group=reportparser
WorkingDirectory=/opt/report_parser
EnvironmentFile=-/opt/report_parser/.env
ExecStart=/opt/report_parser/.venv/bin/gunicorn --config /opt/report_parser/gunicorn.conf.py app:app
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
